# ==============================================================================
# NASWEO WELFARE DATA MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit the real .env file or database passwords to version control.

# Application Server Port
PORT=8080

# Live Supabase Project Settings
# Project URL: https://uhpbciegydqhkltnfnve.supabase.co
SUPABASE_URL=https://uhpbciegydqhkltnfnve.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# PostgreSQL / Supabase Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Direct Host: db.uhpbciegydqhkltnfnve.supabase.co (Port 5432)
# Supabase Pooler: aws-0-[region].pooler.supabase.com (Port 6543 or 5432)
DATABASE_URL=postgresql://postgres:your_rotated_db_password_here@db.uhpbciegydqhkltnfnve.supabase.co:5432/postgres

# Alternatively, configure discrete Spring Datasource variables:
SPRING_DATASOURCE_URL=jdbc:postgresql://db.uhpbciegydqhkltnfnve.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_rotated_db_password_here

# Local Fallback (Leave blank or unset to default to embedded H2 database)
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/nasweodb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_RECONNECT=TRUE

# JWT Token Secret Key (Change for production)
JWT_SECRET=NASWEO_SUPER_SECURE_ENTERPRISE_SECRET_KEY_FOR_NARL_STAFF_WELFARE_ORGANIZATION_2026
JWT_EXPIRATION_MS=86400000
